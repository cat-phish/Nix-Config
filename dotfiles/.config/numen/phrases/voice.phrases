# Cancel sentence
# For example, "four down no five down" would just do "five down".
@cancel no:

# Transcribe a sentence with numen's own recognizer (Vosk)
# For example, "say please type this".
@transcribe say: set numen_fmt echo normal \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1

# Transcribe a sentence formatted...

# With the first letter uppercase
@transcribe upper say: set numen_fmt echo sentence \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# With Each First Letter Uppercase
@transcribe title say: set numen_fmt echo title \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# with_underscrores_inbetween
@transcribe snake say: set numen_fmt echo snake \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# with-dashes-inbetween
@transcribe kebab say: set numen_fmt echo dash \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# with.dots.inbetween
@transcribe dot say: set numen_fmt echo dot \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# with, commas, inbetween
@transcribe list say: set numen_fmt echo list \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# with/slashes/inbetween
@transcribe path say: set numen_fmt echo path \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# allsmashedtogether
@transcribe smash say: set numen_fmt echo smash \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# camelCase
@transcribe camel say: set numen_fmt echo camel \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# PascalCase
@transcribe pascal say: set numen_fmt echo pascal \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# dot.camelCase
@transcribe dot camel say: set numen_fmt echo dotcamel \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# dot.PascalCase
@transcribe dot pascal say: set numen_fmt echo dotpascal \
	pen ~/.config/numen/scripts/tweak; ~/.config/numen/scripts/transcripts | head -n 1
# (You can also do "shout scribe" etc.)

# Erase the transcription
ditch: eval ~/.config/numen/scripts/transcripts | sed 's/./ BackSpace/g; s/^/press/; q'

# Go to the start of the transcription
trudge: eval ~/.config/numen/scripts/transcripts | sed 's/./ Left/g; s/^/press/; q'

# Menus to type or choose another transcription result
# They use the dmenu command (only works in X11) or the command specified
# by $NUMEN_DMENU or $DMENU (you could use wmenu if you're on Wayland).
transcripts: run ~/.config/numen/scripts/menu | numenc & \
	run sleep 0.1
change: run ~/.config/numen/scripts/menu change | numenc & \
	run sleep 0.1


# Ignore this, vosk-model-small-en-us-0.15 can output huh after a long silence.
huh:

# Dictation (Voxtype, modules/home/app-dictation.nix): say "dictate", then
# talk; a 2 s pause, "stop dictating" or Mod+D types it. Meanwhile numen only listens for
# "stop dictating". Backgrounded so numen can process the mode change.
dictate: run dictate start &
