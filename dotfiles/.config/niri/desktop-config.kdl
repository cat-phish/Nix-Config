// Left Monitor
output "DP-2" {
  mode "1920x1080@60.000"
  transform "90"
  position x=0 y=0
  layout {
    default-column-width { proportion 1.0; }
    struts {
        left 16
        right 16
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
  }
}

// Center Monitor
output "DP-1" {
  mode "2560x1440@144.000"
  position x=1080 y=0
  variable-refresh-rate on-demand=true
  layout {
    default-column-width { proportion 0.5; }
    struts {
        left 32
        right 32
    }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
  }
  focus-at-startup
}

// Right Monitor
output "HDMI-A-1" {
  mode "1920x1080@60.000"
  transform "270"
  position x=3640 y=0
  layout {
    default-column-width { proportion 1.0; }
    struts {
        left 16
        right 16
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
  }
}

workspace "browser" {
  open-on-output "DP-1"
}
workspace "terminal" {
  open-on-output "DP-1"
}
workspace "org-mode" {
  open-on-output "DP-2"
}
workspace "calendar" {
  open-on-output "DP-2"
}
workspace "passwords" {
  open-on-output "DP-2"
}
workspace "utilities" {
  open-on-output "DP-2"
}
workspace "chat" {
  open-on-output "HDMI-A-1"
}
workspace "music" {
  open-on-output "HDMI-A-1"
}

// Fix column order on the org-mode workspace once its apps have loaded (any order).
spawn-sh-at-startup "~/.config/niri/scripts/arrange-columns.sh org-mode futo-notes-tauri Emacs"

// Named Workspace Rules
// main monitor
window-rule {
  match at-startup=true app-id=r#"firefox$"#
  open-on-workspace "browser"
  open-maximized true
  // open-focused false
}
window-rule {
  match at-startup=true app-id=r#"kitty$"#
  open-on-workspace "terminal"
  open-maximized true
  open-focused false
}
// left monitor
window-rule {
  match at-startup=true app-id=r#"^futo-notes-tauri$"#
  open-on-workspace "org-mode"
  open-maximized true
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"Emacs$"#
  open-on-workspace "org-mode"
  open-maximized true
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"^(dev\.duxlabs\.calendar|com\.danklinux\.dankcalendar)$"#
  open-on-workspace "calendar"
  open-maximized true
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"^org\.keepassxc\.KeePassXC$"#
  open-on-workspace "passwords"
  open-maximized true
  // default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"konsole$"#
  open-on-workspace "utilities"
  open-maximized true
  // default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"xwaylandvideobridge$"#
  open-on-workspace "utilities"
  open-maximized false
  open-focused false
}
// right monitor
window-rule {
  match at-startup=true app-id=r#"discord$"#
  open-on-workspace "chat"
  open-maximized true
  // default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"konversation$"#
  open-on-workspace "chat"
  open-maximized true
  // default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"nheko$"#
  open-on-workspace "chat"
  open-maximized true
  // default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
    match app-id=r#"foobar2000$"#
    open-maximized true
}
