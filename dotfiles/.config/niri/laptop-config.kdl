// Laptop Screen
output "eDP-1" {
  mode "1920x1200@60.003"
  position x=0 y=0
  scale 1.25
  layout {
    default-column-width { proportion 0.5; }
    struts {
        left 16
        right 16
    }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
  }
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE"

workspace "chat" {
  open-on-output "eDP-1"
}
workspace "utilities" {
  open-on-output "eDP-1"
}
workspace "browser" {
  open-on-output "eDP-1"
}
workspace "terminal" {
  open-on-output "eDP-1"
}
workspace "org-mode" {
  open-on-output "eDP-1"
}
// workspace "utilities"
// workspace "browser"
// workspace "terminal"

// Fix column order on the org-mode workspace once its apps have loaded (any order).
spawn-sh-at-startup "~/.config/niri/scripts/arrange-columns.sh org-mode futo-notes-tauri Emacs dev.duxlabs.calendar"

// Named Workspace Rules
window-rule {
  match at-startup=true app-id=r#"xwaylandvideobridge$"#
  open-on-workspace "utilities"
  open-maximized false
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"konsole$"#
  open-on-workspace "utilities"
  open-maximized false
  default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"^org\.keepassxc\.KeePassXC$"#
  open-on-workspace "utilities"
  open-maximized false
  default-column-width { proportion 0.50; }
}
window-rule {
    match at-startup=true app-id=r#"^futo-notes-tauri$"#
    open-on-workspace "org-mode"
    open-maximized true
    open-focused false
}
window-rule {
    match at-startup=true app-id=r#"^[Ee]macs$"#
    open-on-workspace "org-mode"
    open-maximized true
    open-focused false
}
window-rule {
    match at-startup=true app-id=r#"^(dev\.duxlabs\.calendar|com\.danklinux\.dankcalendar)$"#
    open-on-workspace "org-mode"
    open-maximized true
    open-focused false
}
window-rule {
    match at-startup=true app-id=r#"firefox$"#
    open-on-workspace "browser"
    open-maximized true
    // open-focused false
}
window-rule {
    match at-startup=true app-id=r#"kitty$"#
    open-on-workspace "terminal"
    open-maximized true
    open-focused false
}
window-rule {
  match at-startup=true app-id=r#"discord$"#
  open-on-workspace "chat"
  open-maximized true
  // default-column-width { proportion 0.50; }
}
window-rule {
  match at-startup=true app-id=r#"konversation$"#
  open-on-workspace "chat"
  open-maximized true
  // default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
  match at-startup=true app-id=r#"nheko$"#
  open-on-workspace "chat"
  open-maximized true
  // default-column-width { proportion 0.50; }
  open-focused false
}
window-rule {
    match app-id=r#"foobar2000$"#
    open-maximized true
}
