#!/usr/bin/env bash

# Define your directories
INPUT_DIR="$HOME/music/playlists/windows"
DESKTOP_OUT="$HOME/music/playlists/desktop"
UNRAID_OUT="$HOME/music/playlists/unraid"

# Define the absolute base paths for each system
DESKTOP_BASE="/home/jordan/music/library/"
# Navidrome on Unraid maps the library directly to /music/ internally
UNRAID_BASE="/music/"

# Create output directories if they don't exist
mkdir -p "$DESKTOP_OUT" "$UNRAID_OUT"

# Loop through every .m3u8 file in the Windows directory
for playlist in "$INPUT_DIR"/*.m3u8; do

    # Skip if no m3u8 files are found
    [ -e "$playlist" ] || continue

    # Extract just the filename (e.g., "playlist.m3u8")
    filename=$(basename "$playlist")

    # Process for Desktop
    sed -e 's/\r$//' -e 's|\\|/|g' -e "s|^\.\./Library/|$DESKTOP_BASE|" "$playlist" > "$DESKTOP_OUT/$filename"

    # Process for Unraid
    sed -e 's/\r$//' -e 's|\\|/|g' -e "s|^\.\./Library/|$UNRAID_BASE|" "$playlist" > "$UNRAID_OUT/$filename"

    echo "Converted: $filename"
done

echo "✅ All playlists successfully converted and saved to ~/music/playlists/"
