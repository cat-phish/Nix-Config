#!/usr/bin/env bash
################################################################################
# Script Name: pmrb.sh (Podcast Manager for Rockbox)
# Description: A utility to sync podcasts to a playback device with the goal of
#              emulating the functionality of a modern podcast app.
#              Features:
#                 * Automatic queuing of new episodes in the order that they
#                   were downloaded.
#                 * Decide which podcasts to auto-queue and which don't.
#                 * Auto cleanup of old episodes based on a specified age and
#                   file modified time.
#                 * Auto cleanup of the Queue based on the most recent
#                   bookmark.
#                 * Auto mount and unmount of the device.
#              WARNING - This script deletes source files when syncing. It is
#              recommended to run a separate docker container or instance for
#              your podcast downloading utility if you are already using one for
#              other purposes.
# Author: cat-phish
# Date: 2026-07-26
# Usage: Dependencies - udisks2, rsync, ssh (if remote sync is enabled), Scotty
#                       (if scrobbling is desired), curl (if any remote
#                       notification service is enabled), notify-send/libnotify
#                       (if Linux desktop notifications are enabled)
#        Also Required - A podcast downloading utility like Gpodder
#                        (recommended) or Podgrab, and a Rockbox device.
#        1) Set the configuration options and optionally remote configuration
#           options to match your setup
#        2) If using remote sync setup ssh passwordless login is recommended
#           (https://www.tecmint.com/ssh-passwordless-login-using-ssh-keygen-in-5-easy-steps/)
#        3) Recommended Rockbox settings
#           a) Settings > General Settings > Bookmarks > Bookmark on Stop > Ask
#              (or Yes, but Yes will create bookmarks for non-podcasts)
#           b) Settings > General Settings > Bookmarks > Update on Stop > Yes
#        4) Manually run script or use cron jobs or systemd timers to automate
################################################################################

####################################################
#################      CONFIG      #################
####################################################



### BASIC SETUP ###

# Device name
name="JPOD"

# Podcast path for your downloader
# (No trailing slash!)
source_podcast_path="/mnt/user/drives/downloads/gpodder-ipod"

# Set the device path you would like to sync your podcasts to (e.g. /Podcasts/Shows)
# It is recommended to use a separate folder for permanently stored podcasts (e.g. /Podcasts/Archive)
# especially when using auto-cleanup
# (No trailing slash!)
device_sync_path="/Podcasts/Shows"

# Set the device location you would like to sync your Queue.m3u8 to)
# (No trailing slash!)
device_queue_location="/Podcasts"

# Set the max age for auto-cleanup in days, 0 to disable (based on file modified time)
max_age=60



### QUEUE MGMT ###

# Define the array of podcasts to auto queue
# (this should match case-sensitive to the folder names of each podcast)
auto_queue_shows=(
  "Chapo Trap House"
  "TRUE ANON TRUTH FEED"
  "Box of Neutrals F1 Podcast"
  "pendejotime"
  "WFYM Premium"
  "Podcast About List Premium"
  "Seeking Derangements Patreon"
  "The Late-Round Fantasy Football Podcast"
  "The Secret Patreon"
  "The Standup with ThePrimeagen"
)

# Auto clean the Queue.m3u8 file based on the most recent bookmark from Queue.m3u8.bmark
# (Recommended: "yes")
auto_clean_queue="yes"

# Set how many recent bookmarks to keep in the Queue
# These will be adjusted to their proper spot in your
# updated and saved queue from the device. Unless they
# are removed/truncated frim the queue, in which case
# they will be deleted.
bookmarks_to_keep=10




### ADVANCED FILTERING ###

# Use keywords to filter specific podcasts (case-insensitive).
# Separate multiple keywords with a pipe (|). Leave empty/commented if unused.
# To add multiple podcasts to a list, simply add a new line for each show.
#
# PRECEDENCE RULE: If a podcast uses both a Queue Blacklist and a Queue Whitelist,
# the Blacklist takes priority. If an episode matches both, it will NOT be queued.

# MATCHING RULES:
# 1. Partial Matches: Keywords match anywhere in the filename (case-insensitive).
# 2. Spaces: Spaces work normally. "live show" matches "Show - 01 Live Show.mp3".
# 3. Multiple Keywords: Separate with a pipe (|). e.g., "promo|teaser|trailer"
# 4. Whole Words Only (\b): To prevent short keywords from matching inside longer
#    words (e.g. stopping "art" from matching "Part 1"), wrap the word in '\b'.
#    Example: "\bart\b|\btour\b"

# NOTE: There is no "Sync Whitelist" by design. Because source files are purged
# during sync, a strict sync whitelist would permanently delete non-matching
# episodes off your server/PC if a show slightly changes its episode naming
# format. To safely filter episodes without risking permanent data loss, use
# 'queue_whitelist' instead—this keeps the files on your device while keeping
# them off your main queue.

# Sync Blacklist: Files matching these keywords are DELETED entirely.
# They will not be queued and will never touch your device.
declare -A sync_blacklist
# sync_blacklist["Chapo Trap House"]="teaser|promo|trailer"
# sync_blacklist["TRUE ANON TRUTH FEED"]="tour announcement"
# sync_blacklist["Podcast About List Premium"]="live show"

# Queue Blacklist: Files matching these keywords WILL sync to your device,
# but they will NOT be automatically added to the queue.
declare -A queue_blacklist
# queue_blacklist["WFYM Premium"]="live|announcement"
# queue_blacklist["Pendejo Time"]="bonus clip|update"
queue_blacklist["The Late-Round Fantasy Football Podcast"]="Late-Round Perspectives|Becoming a Best Ball Bro"

# Queue Whitelist: If set for a podcast, ONLY files matching these keywords
# will be added to the queue. Everything else is skipped.
declare -A queue_whitelist
# queue_whitelist["Box of Neutrals F1 Podcast"]="Grand Prix"
# queue_whitelist["TRUE ANON TRUTH FEED"]="Interview"

# Preferred text editor for manual queue editing (falls back to $EDITOR, then nano)
queue_editor="${queue_editor:-${EDITOR:-nano}}"



### TWEAKS ###

# Amount of time to sleep in seconds after mounting the drive in seconds
# (prevents the script from moving on too fast before your system can
# mount your device)
# About 10 seconds is recommended here
sleep_time=10

# Append podcast name to end of the episode file name? (yes or no)
# Podgrab does not add the podcast name to the episode file name, which can cause some
# confusion when viewing the queue
append_podcast_name="no"

# Whether or not to retry the mount if the device is not found immediately
retry_mount="yes"

# Number of times to retry of the mount
max_mount_retries=10



### REMOTE SYNC CONFIGURATION ###

# Remote Sync? (yes or no)
remote_sync="yes"

# Login info for your remote host. Environment variables will work
# here if desired.
# Remote User
remote_user="$MEDIASERVER_SSH_USER"

# Remote Host
remote_host="$MEDIASERVER_SSH_HOST"

# SSH port for a remote host (default is 22)
ssh_port="$MEDIASERVER_SSH_PORT"



### Scobbler Settings ###

# Scrobbling depends on the Scotty scrobbler
# See here for download and setup info:
# https://sr.ht/~phw/scotty/

# Controls if a scrobble attempt is made on every podcast sync.
# You can force a manual scrobble with the -s or --scrobble flag.
scrobble_on_sync="yes"

# Name of the scrobbler log file on your device
# Should be ".scrobbler.log" in almost every case
scrobbler_log=".scrobbler.log"

# Location on the syncing device for the tmp scrobbler.log
# Scotty currently has a parsing bug with Rockbox's
# .scrobbler.log header that this script fixes
tmp_log_location="/tmp/ipod_scotty_scrobbler.log"

# Name of your scrobbling service defined in Scotty config
scrobbler_name="mediaserver-maloja"

# Name of your scorbbler-log service defined in Scotty config
scrobblerlog_name="scrobbler-log"



### NOTIFICATION SETTINGS ###

# Master switch. Must be "yes" for any service below to fire. (yes or no)
notifications_enabled="yes"

# Each service below has its own on/off switch, so you can enable
# any combination of them at once.

# --- ntfy (https://ntfy.sh, or a self-hosted instance) ---
ntfy_enabled="yes"
ntfy_server="$MEDIASERVER_NTFY_SERVER"
ntfy_topic="PMRB"
# Optional bearer token, for authenticated topics / self-hosted servers. Leave empty if unused.
ntfy_token="$MEDIASERVER_NTFY_AUTH_TOKEN"

# --- Gotify (self-hosted) ---
gotify_enabled="no"
gotify_url="https://YOUR_GOTIFY_SERVER"
gotify_token="YOUR_APP_TOKEN"

# --- Pushover ---
pushover_enabled="no"
pushover_token="YOUR_APP_TOKEN"
pushover_user="YOUR_USER_KEY"

# --- Discord (incoming webhook) ---
discord_enabled="no"
discord_webhook_url="YOUR_WEBHOOK_URL"

# --- Linux desktop notification (notify-send / libnotify) ---
# Only useful if this script is run from a logged-in desktop session,
# not headless/cron on a server.
linux_notify_enabled="no"
linux_notify_urgency="normal" # low, normal, or critical

#####################################################
###############      END CONFIG      ################
#####################################################




#####################################################
##############      SCRIPT LOGIC      ###############
##############  Edit at your own risk  ##############
#####################################################

### FUNCTIONS ###

# Internal state (do not edit) - tracks whether the running command is a full
# sync, so mount/unmount failures during -m/-q/-f/-s don't spam notifications
# meant for the sync flow, and the last known scrobble outcome for the summary.
notify_sync_active="no"
scrobble_result="Scrobbling disabled."

# Escapes a string for safe embedding inside a JSON string value.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\r'/}"
  s="${s//$'\n'/\\n}"
  printf '%s' "$s"
}

# Fans a notification out to every enabled service. Silently no-ops if
# notifications_enabled is not "yes". Priority is "default" or "high".
send_notification() {
  local title="$1"
  local message="$2"
  local priority="${3:-default}"

  [ "$notifications_enabled" != "yes" ] && return 0

  if [ "$ntfy_enabled" = "yes" ]; then
    local ntfy_priority="default"
    [ "$priority" = "high" ] && ntfy_priority="urgent"
    if [ -n "$ntfy_token" ]; then
      curl -fsS -H "Title: $title" -H "Priority: $ntfy_priority" \
        -H "Authorization: Bearer $ntfy_token" -d "$message" \
        "$ntfy_server/$ntfy_topic" >/dev/null \
        || echo "Warning: ntfy notification failed."
    else
      curl -fsS -H "Title: $title" -H "Priority: $ntfy_priority" \
        -d "$message" "$ntfy_server/$ntfy_topic" >/dev/null \
        || echo "Warning: ntfy notification failed."
    fi
  fi

  if [ "$gotify_enabled" = "yes" ]; then
    local gotify_priority=5
    [ "$priority" = "high" ] && gotify_priority=8
    curl -fsS -X POST "$gotify_url/message?token=$gotify_token" \
      -F "title=$title" -F "message=$message" -F "priority=$gotify_priority" >/dev/null \
      || echo "Warning: Gotify notification failed."
  fi

  if [ "$pushover_enabled" = "yes" ]; then
    local pushover_priority=0
    [ "$priority" = "high" ] && pushover_priority=1
    curl -fsS --form-string "token=$pushover_token" --form-string "user=$pushover_user" \
      --form-string "title=$title" --form-string "message=$message" \
      --form-string "priority=$pushover_priority" \
      https://api.pushover.net/1/messages.json >/dev/null \
      || echo "Warning: Pushover notification failed."
  fi

  if [ "$discord_enabled" = "yes" ]; then
    local body escaped
    body=$(printf '**%s**\n%s' "$title" "$message")
    escaped=$(json_escape "$body")
    curl -fsS -H "Content-Type: application/json" \
      -d "{\"content\": \"$escaped\"}" "$discord_webhook_url" >/dev/null \
      || echo "Warning: Discord notification failed."
  fi

  if [ "$linux_notify_enabled" = "yes" ] && command -v notify-send >/dev/null 2>&1; then
    local urgency="${linux_notify_urgency:-normal}"
    [ "$priority" = "high" ] && urgency="critical"
    notify-send -u "$urgency" "$title" "$message"
  fi
}

show_help() {
    cat << EOF
Usage: $(basename "$0") [OPTION]

Podcast Manager for Rockbox (pmrb) - Sync podcasts, auto-queue, and manage Rockbox playlists.

Options:
  -h, --help        Show this help message and exit.
  -m, --mount       Mount your device
  -u, --unmount     Unmount your device
  -q, --queue       Mount the iPod, open Queue.m3u8 in \$queue_editor for manual editing,
                    and unmount upon closing.
  -f, --fix         Run an automated fsck repair on the iPod filesystem to clear
                    the dirty bit and fix path corruption (requires sudo).
  -s, --scrobble    Run a manual scrobble using the Scotty scrobbler. (Does not run
                    a podcast sync).

Without options, the script performs a standard podcast sync.
EOF
    exit 0
}

mount_device() {
  local attempt=1
  # Not local: the read-only check in the SYNCING section below relies on
  # this being set as a global by the time mount_device() returns.
  device_path=""
  mount_sleeptime=5

  # Try to find the device, respecting retry settings
  while [ -z "$device_path" ]; do
      device_path=$(blkid -L "$name")

      if [ -z "$device_path" ]; then
          if [ "$retry_mount" = "yes" ] && [ "$attempt" -le "$max_mount_retries" ]; then
              echo "Warning: Device label '$name' not found. Retrying in $mount_sleeptime seconds (Attempt $attempt of $max_mount_retries)..."
              sleep $mount_sleeptime
              attempt=$((attempt + 1))
          else
              echo "Error: Device label '$name' not found."
              [ "$notify_sync_active" = "yes" ] && send_notification "pmrb: Sync Failed" "Device label '$name' not found." "high"
              exit 1
          fi
      fi
  done

  # Verify the device isn't already mounted
  existing_mount=$(findmnt -n -o TARGET "$device_path")
  if [ -n "$existing_mount" ]; then
      echo "Warning: Device '$name' is already mounted at $existing_mount."
      echo "Please unmount it first (run 'pmrb -u') to ensure a clean sync state."
      [ "$notify_sync_active" = "yes" ] && send_notification "pmrb: Sync Failed" "Device '$name' was already mounted at $existing_mount." "high"
      exit 1
  fi

  # Mount the drive and strip the trailing period from udisksctl output
  mount_point=$(udisksctl mount -b "$device_path" | awk '{print $4}' | sed 's/\.$//')

  if [ -n "$mount_point" ]; then
      echo "Mounted $name ($device_path) at: $mount_point"
  else
      echo "Error: Failed to mount device $device_path."
      [ "$notify_sync_active" = "yes" ] && send_notification "pmrb: Sync Failed" "Failed to mount device $device_path." "high"
      exit 1
  fi

  # Wait for device to fully mount
  sleep "$sleep_time"
}

unmount_device() {
   echo "Syncing data to disk..."
   sync

   echo "Unmounting device..."
   local dev_path=$(blkid -L "$name")

   # Retry loop to wait out background indexers
   local max_retries=5
   local count=0

   while ! udisksctl unmount -b "$dev_path" 2>/dev/null; do
      count=$((count + 1))
      if [ $count -ge $max_retries ]; then
         echo "Error: Device is stubbornly busy. The following processes are holding it:"
         lsof +f -- "$dev_path"
         echo "Please close them and unmount manually."
         [ "$notify_sync_active" = "yes" ] && send_notification "pmrb: Unmount Failed" "Device '$name' is stubbornly busy and could not be unmounted. Please unmount manually." "high"
         exit 1
      fi
      echo "Device is busy (likely being scanned). Retrying in 2 seconds... ($count/$max_retries)"
      sleep 5
   done

   echo "Safe to unplug."
}

run_fix() {
  echo "================================================================="
  echo "                      WARNING: DISK REPAIR                       "
  echo "================================================================="
  echo "This will unmount device '$name' and run 'fsck.fat -a -w' to repair"
  echo "filesystem corruption, truncate orphaned files, and clear dirty bits."
  echo ""
  read -p "Are you sure you want to proceed? (y/N): " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
      dev_to_fix=$(blkid -L "$name")
      if [ -z "$dev_to_fix" ]; then
          echo "Error: Device with label '$name' not found."
          exit 1
      fi

      echo "Ensuring $dev_to_fix is unmounted..."
      udisksctl unmount -b "$dev_to_fix" 2>/dev/null

      echo "Running fsck.fat..."
      sudo fsck.fat -a -w "$dev_to_fix"
      echo "Repair complete."
  else
      echo "Operation canceled."
  fi
  exit 0
}

edit_queue() {
  # Check for device
  dev_path=$(blkid -L "$name")
  if [ -z "$dev_path" ]; then
      echo "Error: Device label '$name' not found."
      exit 1
  fi

  echo "Mounting $name for manual editing..."
  m_point=$(udisksctl mount -b "$dev_path" | awk '{print $4}' | sed 's/\.$//')
  sleep 2

  queue_file="$m_point$device_queue_location/Queue.m3u8"

  # Open queue for editing
  if [ -f "$queue_file" ]; then
    echo "Opening $queue_file with $queue_editor..."
    "$queue_editor" "$queue_file"
    echo "Saved changes."
  else
    echo "Error: Queue file not found at $queue_file"
  fi

  # Unmount device
  sleep $sleep_time
  unmount_device
  exit 0
}

scrobble() {
  # mode "manual" (default): called via -s/--scrobble, unmounts and exits itself.
  # mode "sync": called from the end of a full sync; sets $scrobble_result and
  # returns so the caller can fold it into the sync summary notification and
  # handle its own unmount.
  local mode="${1:-manual}"

  # Dynamically find the mount point if it wasn't set by mount_device()
  if [ -z "$mount_point" ]; then
    local dev_path=$(blkid -L "$name")
    mount_point=$(findmnt -n -o TARGET "$dev_path")
  fi

  # Failsafe check
  if [ -z "$mount_point" ]; then
    echo "Error: Device '$name' is not mounted. Cannot scrobble."
    exit 1
  fi

  # Define path using the verified mount point
  scrobbler_log_path="$mount_point/$scrobbler_log"

  # Check if the target log file exists and exit cleanly if it doesn't
  if [ ! -f "$scrobbler_log_path" ]; then
    echo "Notice: No .scrobbler.log found on device. Skipping scrobble."
    scrobble_result="Scrobble: No .scrobbler.log found on device."
    if [ "$mode" = "manual" ]; then
      send_notification "pmrb: Scrobble" "$scrobble_result"
      unmount_device
      exit 0
    fi
    return 0
  fi

  # Strip line 4 (#TRACKNUM) and replace double quotes with single quotes
  # to prevent Scotty's strict parser from crashing on "bare quotes"
  sed "4d; s/\"/'/g" "$scrobbler_log_path" > "$tmp_log_location"

  # Run Scotty to beam the listens to scrobbler
  echo "Beaming scrobbles to $scrobbler_name via Scotty..."
  local scotty_output
  scotty_output=$(scotty beam listens "$scrobblerlog_name" "$scrobbler_name" 2>&1)
  SCOTTY_EXIT=$?
  echo "$scotty_output"

  # Clean up the temp file
  rm -f "$tmp_log_location"

  # Handle success/failure based on mode
  if [ $SCOTTY_EXIT -eq 0 ]; then
      echo "Sync successful! Rotating live log to backup (.bak)..."
      mv -f "$scrobbler_log_path" "$scrobbler_log_path.bak"
      echo "Done! .scrobbler.log has been moved to .scrobbler.log.bak."
      scrobble_result="Scrobble: Success."
  else
      echo "------------------------------------------------------------------"
      echo "Error: Scotty sync failed (Exit code: $SCOTTY_EXIT)."
      echo "No log files were modified, so you can safely retry."
      echo "------------------------------------------------------------------"
      if echo "$scotty_output" | grep -qEi "syntax|parse error"; then
        scrobble_result="Scrobble: Failed - syntax error in .scrobbler.log (exit $SCOTTY_EXIT)."
      else
        scrobble_result="Scrobble: Failed (exit $SCOTTY_EXIT)."
      fi
  fi

  if [ "$mode" = "manual" ]; then
    send_notification "pmrb: Scrobble" "$scrobble_result" "$([ $SCOTTY_EXIT -ne 0 ] && echo high || echo default)"
    unmount_device
    # Exit script to avoid double unmount when called at end of script
    exit 0
  fi
}



### ARGUMENT PARSING ###

# Parse options
case "$1" in
    "")
        # No argument: fall through to full sync below.
        ;;
    -h|--help)
        show_help
        ;;
    -m|--mount)
        mount_device
        exit 0
        ;;
    -u|--unmount)
        unmount_device
        exit 0
        ;;
    -f|--fix)
        run_fix
        exit 0
        ;;
    -q|--queue)
        edit_queue
        exit 0
        ;;
    -s|--scrobble)
        mount_device
        scrobble
        exit 0
        ;;
    *)
        echo "Unknown option: $1"
        echo "Use -h or --help for usage information."
        exit 1
        ;;
esac

### SYNCING ###

# Mark this as a full sync run so mount/unmount failures below trigger notifications.
notify_sync_active="yes"

# Attempt to mount the defined device
mount_device

# Abort if the device mounted read-only to prevent script failure
if findmnt -n -o OPTIONS "$device_path" | grep -E -q '(^|,)ro(,|$)'; then
    echo "Error: Device mounted read-only! Filesystem requires repair."
    send_notification "pmrb: Sync Failed" "Device '$name' mounted read-only. Filesystem requires repair (see -f/--fix)." "high"
    udisksctl unmount -b "$device_path"
    exit 1
fi

# Create a local temporary directory on syncing device
local_tmp="/tmp/pmrb_sync"
mkdir -p "$local_tmp"

# Helper variable for audio file extensions
audio_exts="\( -name '*.mp3' -o -name '*.m4a' -o -name '*.wav' -o -name '*.ogg' \)"

if [ "$remote_sync" = "yes" ]; then
   # Sync from remote source to the local temp directory
   rsync -avz --exclude='.tmp*' -e "ssh -p $ssh_port" --progress --times "$remote_user@$remote_host:$source_podcast_path/" "$local_tmp/"

   # Delete source audio files from the server (including extensionless audio)
   ssh -p $ssh_port $remote_user@$remote_host "
      find '$source_podcast_path/' -type f $audio_exts -exec rm -f {} +
      find '$source_podcast_path/' -type f ! -name '*.jpg' ! -name '*.png' ! -name '*.json' ! -name '*.xml' | while read -r f; do
         mime=\$(file -b --mime-type \"\$f\")
         case \"\$mime\" in
            audio/*|video/mp4) rm -f \"\$f\" ;;
         esac
      done
   "
else
   # Sync from local source to local temp directory
   rsync -av --exclude='.tmp*' --progress --times "$source_podcast_path/" "$local_tmp/"

   # Delete source audio files (including extensionless audio) locally
   find "$source_podcast_path/" -type f -eval $audio_exts -exec rm -f {} +
   find "$source_podcast_path/" -type f ! -name "*.jpg" ! -name "*.png" ! -name "*.json" ! -name "*.xml" -print0 | while IFS= read -r -d $'\0' f; do
      mime=$(file -b --mime-type "$f")
      case "$mime" in
         audio/*|video/mp4) rm -f "$f" ;;
      esac
   done
fi

# Automatically detect and fix extensionless audio files in local_tmp
find "$local_tmp" -type f ! -name "*.mp3" ! -name "*.m4a" ! -name "*.wav" ! -name "*.ogg" ! -name "*.jpg" ! -name "*.png" -print0 | while IFS= read -r -d $'\0' f; do
   mime=$(file -b --mime-type "$f")
   case "$mime" in
      audio/mpeg) mv "$f" "$f.mp3" ;;
      audio/mp4|audio/x-m4a|video/mp4) mv "$f" "$f.m4a" ;;
      audio/x-wav|audio/wav) mv "$f" "$f.wav" ;;
      audio/ogg|application/ogg) mv "$f" "$f.ogg" ;;
   esac
done

# Rename each file to include the parent folder name (if enabled)
if [ "$append_podcast_name" = "yes" ]; then
   find "$local_tmp" -type f \( -name '*.mp3' -o -name '*.m4a' -o -name '*.wav' -o -name '*.ogg' \) -print0 | while IFS= read -r -d $'\0' file; do
      dir=$(dirname "$file")
      base=$(basename "$file")
      parent=$(basename "$dir")
      mv "$file" "$dir/${base%.*} - $parent.${file##*.}"
   done
fi

# ---------------------------------------------------------
# Sync Blacklist (Delete files before syncing to iPod)
# ---------------------------------------------------------
if [ ${#sync_blacklist[@]} -gt 0 ]; then
   for podcast in "${!sync_blacklist[@]}"; do
      if [ -d "$local_tmp/$podcast" ]; then
         find "$local_tmp/$podcast" -type f -print0 | while IFS= read -r -d $'\0' file; do
            filename=$(basename "$file")
            if echo "$filename" | grep -qEi "${sync_blacklist[$podcast]}"; then
               echo "Deleting (Sync Blacklist): $filename"
               rm -f "$file"
            fi
         done
      fi
   done
fi
# ---------------------------------------------------------

# Create a sorted list of files based on modified date
> sorted_files.txt # Clear or create the file safely
search_dirs=()

# Build a list of valid directories to search based on the array
for podcast in "${auto_queue_shows[@]}"; do
   if [ -d "$local_tmp/$podcast" ]; then
       search_dirs+=("$local_tmp/$podcast")
   fi
done

# Find new episodes across tracked shows and sort them together globally by date
if [ ${#search_dirs[@]} -gt 0 ]; then
   find "${search_dirs[@]}" -type f \( -name '*.mp3' -o -name '*.m4a' -o -name '*.wav' -o -name '*.ogg' \) -printf '%T@ %p\0' | sort -z -n | cut -z -d ' ' -f2- > sorted_files.txt
fi

# Append the newly synced auto-queue episodes to the m3u8 playlist queue
# Tracks which local_tmp paths actually got appended to Queue.m3u8, so the
# sync summary notification can mark them "(Queued)".
declare -A queued_lookup=()

if [ -s sorted_files.txt ]; then
    # Failsafe: Ensure the Queue file has a clean line break before appending
    sed -i -e '$a\' "$mount_point$device_queue_location/Queue.m3u8" 2>/dev/null

    while IFS= read -r -d $'\0' line; do
       podcast_name=$(basename "$(dirname "$line")")
       filename=$(basename "$line")

       # ---------------------------------------------------------
       # FILTER: Queue Blacklist & Whitelist
       # ---------------------------------------------------------
       # Check Queue Blacklist
       if [[ -n "${queue_blacklist[$podcast_name]}" ]] && echo "$filename" | grep -qEi "${queue_blacklist[$podcast_name]}"; then
           echo "Skipping Queue (Queue Blacklist): $filename"
           continue
       fi

       # Check Queue Whitelist
       if [[ -n "${queue_whitelist[$podcast_name]}" ]] && ! echo "$filename" | grep -qEi "${queue_whitelist[$podcast_name]}"; then
           echo "Skipping Queue (Queue Whitelist): $filename"
           continue
       fi
       # ---------------------------------------------------------

       queued_lookup["$line"]=1

       # Swap local tmp path for Rockbox's sync path
       playlist_path="${line/$local_tmp/$device_sync_path}"
       echo "$playlist_path" >>"$mount_point$device_queue_location/Queue.m3u8"
    done <sorted_files.txt

    # Strip any blank lines from the queue that the previous commands might have created
    sed -i '/^$/d' "$mount_point$device_queue_location/Queue.m3u8"
fi
rm -f sorted_files.txt

# ---------------------------------------------------------
# Record podcast/episode names actually being synced to the device
# (used for both the end-of-run summary and the sync notification)
# ---------------------------------------------------------
synced_items=()
while IFS= read -r -d $'\0' f; do
   ep_podcast=$(basename "$(dirname "$f")")
   ep_name=$(basename "$f")
   suffix=""
   [ -n "${queued_lookup[$f]}" ] && suffix=" (Queued)"
   synced_items+=("$ep_podcast - $ep_name$suffix")
done < <(find "$local_tmp" -type f \( -name '*.mp3' -o -name '*.m4a' -o -name '*.wav' -o -name '*.ogg' \) -print0)

# Transfer from local tmp to the device folders
rsync -av "$local_tmp/" "$mount_point$device_sync_path/"

# Clean up the local tmp directory
rm -rf "$local_tmp"

# Auto-cleanup old files based on max_age
if [ "$max_age" -gt 0 ]; then
   find "$mount_point$device_sync_path" -type f \( -name '*.mp3' -o -name '*.m4a' -o -name '*.wav' -o -name '*.ogg' \) -mtime +$max_age -exec rm -f {} \;
fi

# Check if auto_clean_queue is set to yes
if [ "$auto_clean_queue" == "yes" ]; then
   bmark_file="$mount_point$device_queue_location/Queue.m3u8.bmark"
   queue_file="$mount_point$device_queue_location/Queue.m3u8"

   if [ -f "$bmark_file" ]; then
      # Deduplicate bookmarks, keep only most recent occurrence of each episode
      > "${bmark_file}.dedup"
      declare -A seen_bmarks

      while IFS= read -r bmark_line || [ -n "$bmark_line" ]; do
          [ -z "$bmark_line" ] && continue
          # Safely strip \r using bash string manipulation
          clean_line="${bmark_line//$'\r'/}"
          IFS=';' read -ra line_parts <<< "$clean_line"
          path_key="${line_parts[-1]}"

          # If we haven't seen this file path yet, keep it
          if [ -z "${seen_bmarks[$path_key]}" ]; then
              seen_bmarks["$path_key"]=1
              printf "%s\r\n" "$clean_line" >> "${bmark_file}.dedup"
          fi
      done < "$bmark_file"
      mv "${bmark_file}.dedup" "$bmark_file"

      # Identify the most recent episode to safely truncate the queue
      # NOTE: Added tr to strip the carriage return here to ensure clean string matching!
      first_line=$(head -n 1 "$bmark_file" | tr -d '\r')
      IFS=';' read -ra first_parts <<<"$first_line"
      recent_podcast_path="${first_parts[-1]}"

      # Read the current queue into an array, stripping Rockbox's Windows \r carriage returns
      mapfile -t queue_lines < <(tr -d '\r' < "$queue_file")
      matched_index=-1

      # Find where the most recent podcast is in the current queue
      for i in "${!queue_lines[@]}"; do
         if [[ "${queue_lines[$i]}" == *"$recent_podcast_path"* ]]; then
            matched_index=$i
            break
         fi
      done

      if [ $matched_index -ne -1 ]; then
         # Create the new queue by dropping everything before the most recent podcast
         new_queue_lines=("${queue_lines[@]:$matched_index}")
         printf "%s\n" "${new_queue_lines[@]}" >"$queue_file"
         echo "Updated $queue_file successfully."

         # Process up to $bookmarks_to_keep
         > "${bmark_file}.new"
         while IFS= read -r bmark_line || [ -n "$bmark_line" ]; do
             # Skip empty lines just in case
             [ -z "$bmark_line" ] && continue

             # Strip \r from the bookmark line to avoid fat32/linux fs compatibility errors
             bmark_line="${bmark_line//$'\r'/}"

             # Break the Rockbox bookmark format into an array
             IFS=';' read -ra parts <<<"$bmark_line"
             bmark_path="${parts[-1]}"

             # Search for this specific bookmark's file in the new truncated queue
             new_index=-1
             for i in "${!new_queue_lines[@]}"; do
                 if [[ "${new_queue_lines[$i]}" == *"$bmark_path"* ]]; then
                     new_index=$i
                     break
                 fi
             done

             # If the file survived the cleanup and is still in queue,
             # update its playlist index and save it
             if [ $new_index -ne -1 ]; then
                 parts[1]=$new_index
                 modified_line=$(IFS=';'; echo "${parts[*]}")

                 # Save with Rockbox's expected fat32 formatting
                 printf "%s\r\n" "$modified_line" >> "${bmark_file}.new"
             fi
         done < <(head -n "$bookmarks_to_keep" "$bmark_file")

         # Overwrite the old bookmark file with the recalculated ones
         mv "${bmark_file}.new" "$bmark_file"
         echo "Updated bookmarks successfully."
      else
         echo "No matching line found in $queue_file. Queue unchanged."
      fi
   else
      echo "$bmark_file does not exist. Skipping queue cleanup."
   fi
fi

# Run scrobble post_sync if set
if [ "$scrobble_on_sync" = "yes" ]; then
   scrobble "sync"
fi

# ---------------------------------------------------------
# Build and show the sync summary (always), and notify (if enabled)
# ---------------------------------------------------------
if [ ${#synced_items[@]} -gt 0 ]; then
   episode_summary=$(printf '%s\n' "${synced_items[@]}")
else
   episode_summary="No new episodes synced."
fi
summary_message=$(printf '%s\n\n%s' "$episode_summary" "$scrobble_result")

echo "==================================================================="
echo "pmrb: Sync Complete"
echo "==================================================================="
echo "$summary_message"
echo "==================================================================="

if [ "$notifications_enabled" = "yes" ]; then
   send_notification "pmrb: Sync Complete" "$summary_message"
fi

unmount_device
