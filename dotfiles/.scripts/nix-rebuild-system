#!/usr/bin/env bash

# sudo nixos-rebuild switch --flake ~/.nix

set -euo pipefail

FLAKE_PATH="$HOME/.nix"
ORIGINAL_DIR=$(pwd)
# Cleanup: kill sudo loop and return to original directory
trap 'cd "$ORIGINAL_DIR"; [ -n "${SUDO_PID:-}" ] && kill "$SUDO_PID" 2>/dev/null' EXIT

# --- Helper Functions ---

# Keep sudo alive for the system-level rebuild
keep_sudo_alive() {
  echo "Authenticating for System-level tasks..."
  sudo -v
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
}

sync_remote() {
  cd "$FLAKE_PATH"
  echo "Checking remote for updates..."
  if ! git fetch origin >/dev/null 2>&1; then
    echo "[!] git fetch failed (offline?); skipping remote sync."
    return 0
  fi
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse @{u})" ]; then
    echo "Remote changes found. Synchronizing..."
    if ! git rebase --autostash "origin/$(git branch --show-current)"; then
      git rebase --abort 2>/dev/null || true
      echo "[!] Rebase conflicted (same file changed on both machines?). Aborted; local changes kept."
      echo "    Resolve manually: cd ~/.nix && git pull"
      exit 1
    fi
      # --autostash can "succeed" yet leave conflict markers when re-applying uncommitted edits.
      if [ -n "$(git diff --name-only --diff-filter=U)" ]; then
        echo "[!] Your uncommitted edits conflict with the incoming changes in:"
        git diff --name-only --diff-filter=U | sed 's/^/      /'
        echo "    Your edits are safe in 'git stash list'. Fix the files, then run: git stash drop"
        exit 1
      fi
  else
    echo "[✓] Git repo is up to date."
  fi
}

handle_git_workflow() {
  cd "$FLAKE_PATH"

  # Refresh the DMS plugin lockfile so GUI plugin installs/updates get committed too.
  if [ -x /usr/bin/dms ]; then
    /usr/bin/dms plugins lock -o "$FLAKE_PATH/dotfiles/.config/dms/plugins.lock.json" >/dev/null 2>&1 || true
  fi
  if [ -n "$(git status --porcelain)" ]; then
    echo "--------------------------------------------------"
    echo "[!] Uncommitted system configuration changes:"
    git status -s
    echo "--------------------------------------------------"

    read -p "Commit and push these changes now? (Y/n): " confirm
    if [[ -z $confirm || $confirm == [yY] ]]; then
      read -p "Commit message (Enter for timestamp): " msg
      [ -z "$msg" ] && msg="System-only rebuild [$(date +'%Y-%m-%d %H:%M:%S')]"

      git add .
      git commit -m "$msg"
      git push
      echo "[✓] Changes synced."
    else
      echo "[!] Warning: Proceeding with uncommitted system changes."
    fi
  fi
}

# --- Main Execution ---

# 1. Sync and Guard
sync_remote
handle_git_workflow

# 2. Authenticate
keep_sudo_alive
SUDO_PID=$!

# 3. System Rebuild (No Home-Manager switch)
echo "Rebuilding NixOS System..."
if sudo nixos-rebuild switch --flake "$FLAKE_PATH"; then
  echo "--------------------------------------------------------"
  echo "[✓] System rebuild successful."
  echo "Note: Home-manager was NOT switched in this run."
  echo "--------------------------------------------------------"
else
  echo "[!] System rebuild failed."
  exit 1
fi
