#!/usr/bin/env bash

# ORIGINAL_DIR=$(pwd)
# trap 'cd "$ORIGINAL_DIR"' EXIT
#
# cd ~/.nix
# git pull --rebase
# sudo nix flake update --flake ~/.nix
# git add .
# git commit -m "Nix flake update [$(date +'%Y-%m-%d %H:%M:%S')]"
# git push
#
# home-manager switch -b backup --flake ~/.nix
#
# sudo nix-collect-garbage --delete-older-than 14d

set -euo pipefail

FLAKE_PATH="$HOME/.nix"
ORIGINAL_DIR=$(pwd)
# Cleanup: ensure we go back home and stop the sudo-keep-alive loop
trap 'cd "$ORIGINAL_DIR"; [ -n "${SUDO_PID:-}" ] && kill "$SUDO_PID" 2>/dev/null' EXIT

# --- Helper Functions ---

# Keep sudo alive ONLY for the garbage collection at the end
keep_sudo_alive() {
  echo "Authenticating for system tasks (GC)..."
  sudo -v
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
}

sync_remote() {
  cd "$FLAKE_PATH"
  echo "Checking for remote updates..."
  if ! git fetch origin >/dev/null 2>&1; then
    echo "[!] git fetch failed (offline?); skipping remote sync."
    return 0
  fi
  # Only rebase if local is different from remote
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse @{u})" ]; then
    echo "Remote changes found. Synchronizing..."
    if ! git rebase --autostash "origin/$(git branch --show-current)"; then
      git rebase --abort 2>/dev/null || true
      echo "[!] Rebase conflicted (same file changed on both machines?). Aborted; local changes kept."
      echo "    Resolve manually: cd ~/.nix && git pull"
      exit 1
    fi
      # --autostash can "succeed" yet leave conflict markers when re-applying uncommitted edits.
      if [ -n "$(git diff --name-only --diff-filter=U)" ]; then
        echo "[!] Your uncommitted edits conflict with the incoming changes in:"
        git diff --name-only --diff-filter=U | sed 's/^/      /'
        echo "    Your edits are safe in 'git stash list'. Fix the files, then run: git stash drop"
        exit 1
      fi
  else
    echo "[✓] Already up to date with remote."
  fi
}

handle_git_workflow() {
  cd "$FLAKE_PATH"

  # 1. Update the lockfile first
  echo "Updating nix flake..."
  nix flake update

  # 2. Check for changes (either flake.lock or your .nix files)
  # Save DMS plugin / Vicinae extension installs, updates and uninstalls made in their GUIs
  # into the repo, so they get committed too.
  "$FLAKE_PATH/dotfiles/.scripts/save-gui-plugins" || true
  if [ -n "$(git status --porcelain)" ]; then
    echo "--------------------------------------------------------"
    echo "[!] Changes detected (lockfile or config edits):"
    git status -s
    echo "--------------------------------------------------------"

    read -p "Would you like to sync these changes? (Y/n): " confirm
    if [[ -z $confirm || $confirm == [yY] ]]; then
      read -p "Commit message (Enter for timestamp): " msg
      [ -z "$msg" ] && msg="Nix flake update [$(date +'%Y-%m-%d %H:%M:%S')]"

      git add .
      git commit -m "$msg"
      git push
      echo "[✓] Git sync complete."
    else
      echo "[!] Warning: Proceeding with uncommitted changes."
    fi
  else
    echo "[-] No changes to commit."
  fi
}

# --- Main Execution ---

# 1. Pre-sync to avoid building on stale code
sync_remote

# 2. Update and handle Git
handle_git_workflow

# 3. Apply changes (User-level, usually no sudo needed)
echo "Starting home-manager switch..."
if home-manager switch -b backup --flake "$FLAKE_PATH"; then
  echo "[✓] Home Manager updated successfully."
else
  echo "[!] Home Manager update failed."
  exit 1
fi

# 4. Cleanup (System-level, needs sudo)
echo ""
keep_sudo_alive
SUDO_PID=$!

# Refresh Nix GPU drivers if the flake update changed them (no-op otherwise)
"$FLAKE_PATH/dotfiles/.scripts/nix-gpu-setup" || true

echo "Running garbage collection..."
sudo nix-collect-garbage --delete-older-than 14d
echo "[✓] Cleanup complete."
