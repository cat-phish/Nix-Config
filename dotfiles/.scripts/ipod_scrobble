IPOD_LOG="/run/media/jordan/JPOD/.scrobbler.log"
BACKUP_LOG="/run/media/jordan/JPOD/.scrobbler.log.bak"
TEMP_LOG="/tmp/ipod_scotty_scorbbler.log"
MALOJA_NAME="mediaserver-maloja"
SCROBBLER_NAME="scrobbler-log"

name="JPOD"
sleep_time=10
USE_BAK=false

# Parse command line flags
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -b|--bak) USE_BAK=true ;;
        *) echo "Unknown parameter: $1"; exit 1 ;;
    esac
    shift
done

# Determine which log file to process
if [ "$USE_BAK" = true ]; then
    SOURCE_LOG="$BACKUP_LOG"
    echo "Running in BACKUP mode (-b). Using $SOURCE_LOG"
else
    SOURCE_LOG="$IPOD_LOG"
    echo "Running in NORMAL mode. Using live $SOURCE_LOG"
fi

# Mount iPod
echo "Mounting iPod..."
mount_output=$(udisksctl mount -b "$(blkid -L $name)" 2>&1)
sleep $sleep_time
if [ $? -ne 0 ]; then
    echo "Error: Failed to mount iPod. Output: $mount_output"
    exit 1
fi

# Extract mount point cleanly
mount_point=$(echo "$mount_output" | grep -oE '/run/media/[^ ]+')
echo "Mounted at $mount_point"

# Check if the target log file exists
if [ ! -f "$SOURCE_LOG" ]; then
    echo "Error: Log file not found at $SOURCE_LOG."
    udisksctl unmount -b "$(blkid -L $name)"
    exit 1
fi

# Strip line 4 (#TRACKNUM) to prevent Scotty's parser from crashing
sed '4d' "$SOURCE_LOG" > "$TEMP_LOG"

# Run Scotty to beam the listens to Maloja
echo "Beaming scrobbles to Maloja via Scotty..."
scotty beam listens "$SCROBBLER_NAME" "$MALOJA_NAME"
SCOTTY_EXIT=$?

# Clean up the temp file
rm -f "$TEMP_LOG"

# Handle success/failure based on mode
if [ $SCOTTY_EXIT -eq 0 ]; then
    if [ "$USE_BAK" = true ]; then
        echo "Sync from backup successful! Backup log preserved untouched."
    else
        echo "Sync successful! Rotating live log to backup (.bak)..."
        mv -f "$IPOD_LOG" "$BACKUP_LOG"
        echo "Done! .scrobbler.log has been moved to .scrobbler.log.bak."
    fi
else
    echo "------------------------------------------------------------------"
    echo "Error: Scotty sync failed (Exit code: $SCOTTY_EXIT)."
    echo "No log files were modified, so you can safely retry."
    echo "------------------------------------------------------------------"
fi

# Unmount iPod safely
echo "Unmounting iPod..."
udisksctl unmount -b "$(blkid -L $name)"
echo "Safe to unplug."
