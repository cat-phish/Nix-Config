# --- Helper Functions ---

# Check if a command exists
cmd_exists() { command -v "$1" >/dev/null 2>&1; }

# Keep sudo timestamp updated while the script runs
keep_sudo_alive() {
  # Update the timestamp immediately
  sudo -v

  # Run a background loop to refresh the timestamp every 60 seconds
  while true; do
    sudo -n true
    sleep 60
    # Exit the loop if the parent script finishes
    kill -0 "$$" || exit
  done 2>/dev/null &
}

# Clear credentials on exit
clear_sudo() {
  sudo -k
}

# Stop if there are uncommitted manual changes
# Check for uncommitted manual changes and offer to commit them
check_git_status() {
  if [ ! -d "$FLAKE_PATH/.git" ]; then return 0; fi
  cd "$FLAKE_PATH"

  # Check for both modified tracked files and new untracked .nix files
  if [ -n "$(git status --porcelain)" ]; then
    echo "--------------------------------------------------------"
    echo "[!] Uncommitted changes detected in $FLAKE_PATH:"
    git status -s
    echo "--------------------------------------------------------"
    read -r -p "Would you like to stage and commit these changes now? [Y/n] " response
    response=${response:-Y}

    if [[ "$response" =~ ^[Yy]$ ]]; then
      read -r -p "Enter commit message (leave blank for default): " commit_msg
      if [ -z "$commit_msg" ]; then
        commit_msg="Update Nix configuration [$(date +'%Y-%m-%d %H:%M:%S')]"
      fi
      git add -A
      git commit -m "$commit_msg"
      echo "[✓] Local changes committed"
    else
      echo "[!] Aborting. Please commit or stash your manual edits first."
      exit 1
    fi
  fi
}

# Sync with remote before making any changes
git_sync_remote() {
  if [ ! -d "$FLAKE_PATH/.git" ]; then return 0; fi
  cd "$FLAKE_PATH"
  echo "Syncing with remote repository..."
  git fetch origin
  # Rebase to keep a clean, linear history
  git rebase origin/$(git branch --show-current)
  echo "[✓] Git sync complete"
}

# Update the flake.lock
update_flake() {
  if ! cmd_exists nix; then
    echo "nix not found; skipping flake update."
    return 1
  fi
  echo "Updating flake at $FLAKE_PATH..."
  cd "$FLAKE_PATH"
  if nix flake update; then
    echo "[✓] Flake updated"
  else
    echo "[!] Failed to update flake"
    return 1
  fi
}

# Download/update AppImages in ~/.apps/appimages and create .desktop launchers
update_appimages() {
  local app_dir="$USER_HOME/.apps/appimages"
  local icon_dir="$USER_HOME/.local/share/icons"
  local desktop_dir="$USER_HOME/.local/share/applications"

  mkdir -p "$app_dir" "$icon_dir" "$desktop_dir"

  # Format: "binary_name|Display Name|github_owner/repo|url_template|categories|env_prefix"
  # {TAG} = full release tag (e.g. v1.0.34), {VER} = tag without leading 'v' (e.g. 1.0.34)
  local apps=(
    "navibeat|NaviBeat|nenadjokic/navibeat-linux|https://github.com/nenadjokic/navibeat-linux/releases/download/{TAG}/NaviBeat-linux-x86_64.AppImage|AudioVideo;Audio;Player;|env _JAVA_AWT_WM_NONREPARENTING=1 "
    "artcraft-launcher|ArtCraft Launcher|storytold/craft-launcher|https://github.com/storytold/craft-launcher/releases/download/{TAG}/artcraft-launcher-{VER}-linux-x86_64.AppImage|Graphics;Office;Utility;|"
  )

  for entry in "${apps[@]}"; do
    IFS='|' read -r bin_name display_name repo url_template categories env_prefix <<< "$entry"
    echo "Checking $display_name ($repo) for updates..."

    # Resolve latest tag via web redirect (bypasses api.github.com 403 rate limits)
    local redirect_url latest_tag latest_ver
    redirect_url=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${repo}/releases/latest") || {
      echo "[!] Failed to resolve latest release for $repo"
      continue
    }

    latest_tag="${redirect_url##*/}"
    latest_ver="${latest_tag#v}"

    if [ -z "$latest_tag" ] || [ "$latest_tag" = "latest" ]; then
      echo "[!] Could not determine latest tag for $repo"
      continue
    fi

    local download_url="${url_template//\{TAG\}/$latest_tag}"
    download_url="${download_url//\{VER\}/$latest_ver}"

    local version_file="$app_dir/.${bin_name}.version"
    local current_tag=""
    [ -f "$version_file" ] && current_tag=$(cat "$version_file")

    local target_bin="$app_dir/$bin_name"

    if [ "$latest_tag" != "$current_tag" ] || [ ! -f "$target_bin" ]; then
      echo "Downloading $display_name ($latest_tag)..."
      if curl -fL "$download_url" -o "${target_bin}.tmp"; then
        chmod +x "${target_bin}.tmp"
        mv "${target_bin}.tmp" "$target_bin"
        echo "$latest_tag" > "$version_file"

        # Extract icon from the AppImage
        local tmp_extract
        tmp_extract=$(mktemp -d)
        (
          cd "$tmp_extract"
          "$target_bin" --appimage-extract "*.png" >/dev/null 2>&1 || true
          "$target_bin" --appimage-extract "usr/share/icons/**/*.png" >/dev/null 2>&1 || true
          local found_icon
          found_icon=$(find squashfs-root -name "*.png" -type f 2>/dev/null | head -n1)
          if [ -n "$found_icon" ]; then
            cp "$found_icon" "$icon_dir/${bin_name}.png"
          fi
        )
        rm -rf "$tmp_extract"
        echo "[✓] Updated $display_name to $latest_tag"
      else
        echo "[!] Failed to download $download_url"
        rm -f "${target_bin}.tmp"
        continue
      fi
    else
      echo "[-] $display_name is already up to date ($current_tag)"
    fi

    # Ensure .desktop file exists
    cat > "$desktop_dir/${bin_name}.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$display_name
Exec=${env_prefix}${target_bin}
Icon=$icon_dir/${bin_name}.png
Terminal=false
Categories=$categories
EOF
  done

  if cmd_exists update-desktop-database; then
    update-desktop-database "$desktop_dir" 2>/dev/null || true
  fi
}

# Commit flake.lock if changed, and push any unpushed commits
git_commit_push() {
  if [ ! -d "$FLAKE_PATH/.git" ]; then return 0; fi
  cd "$FLAKE_PATH"

  if ! git diff --exit-code flake.lock >/dev/null; then
    echo "Changes detected in flake.lock. Committing..."
    git add flake.lock
    git commit -m "Nix flake update [$(date +'%Y-%m-%d %H:%M:%S')]"
  else
    echo "[-] No changes detected in flake.lock."
  fi

  # Push if local branch is ahead of remote
  if [ -n "$(git log @{u}.. 2>/dev/null)" ]; then
    echo "Pushing commits to remote..."
    git push
    echo "[✓] Changes pushed to remote"
  fi
}

# Nix home-manager rebuild
rebuild_home() {
  echo "Rebuilding Home Manager..."
  if ! home-manager switch -b backup --flake "$FLAKE_PATH"; then
    echo "[!] home-manager switch failed"
    return 1
  fi
  echo "[✓] Home Manager switch succeeded"
}

# Run Nix Garbage Collection
gc_nix() {
  echo "Running Nix garbage collection (older than 14d)..."
  sudo nix-collect-garbage --delete-older-than 14d
}

# --- Main Execution ---

if [ "$(id -u)" -eq 0 ]; then
  echo "Please run this script as your regular user (not as root)."
  exit 1
fi

# Start sudo loop
echo "This script requires sudo for system updates. Please authenticate:"
keep_sudo_alive
SUDO_LOOP_PID=$! # Capture the PID of the background loop

# This ensures that if the script exits (normally or by error),
# we kill the background loop and clear the sudo timestamp.
trap 'kill "$SUDO_LOOP_PID" 2>/dev/null; sudo -k; cd "$ORIGINAL_DIR"; echo "Cleaned up sudo and returned to $ORIGINAL_DIR"' EXIT

OS_ID=""
if [ -f /etc/os-release ]; then
  . /etc/os-release
  OS_ID="${ID:-}"
fi

echo "Detected OS: $OS_ID"
echo "---------------------------------------"

# Step 1: Safety Checks & Sync
check_git_status
git_sync_remote

# Step 2: Update Flake & Share
update_flake || true
git_commit_push || true

# Step 3: Apply System Changes
case "$OS_ID" in
  nixos)
    echo "Applying NixOS System Rebuild..."
    if sudo nixos-rebuild switch --flake "$FLAKE_PATH"; then
      echo "[✓] nixos-rebuild succeeded"
    else
      echo "[!] nixos-rebuild failed"
      exit 1
    fi
    rebuild_home || true
    gc_nix || true

    echo "Updating Zsh Zinit and its Plugins..."
    zinit self-update
    zinit update

    echo "Cleaning up stale Zsh completions..."
    find "$HOME/.local/share/zinit/completions" -xtype l -delete 2>/dev/null || true
    rm -f "$HOME"/.zcompdump* || true
    ;;

  fedora)
    echo "Applying Fedora DNF Upgrade..."
    sudo dnf upgrade --refresh -y

    echo "Updating Zsh Zinit and its Plugins..."
    sudo -u "$ACTUAL_USER" zsh <<-EOF
        source "$USER_HOME/.local/share/zinit/zinit.git/zinit.zsh"
        zinit self-update
        zinit update
        find "$USER_HOME/.local/share/zinit/completions" -xtype l -delete 2>/dev/null || true
        rm -f "$USER_HOME"/.zcompdump* || true
EOF

    rebuild_home || true
    update_appimages || true
    if cmd_exists nix; then gc_nix || true; fi
    ;;

  *)
    echo "Unsupported OS. Attempting Home Manager rebuild only..."
    rebuild_home || true
    ;;
esac

echo "---------------------------------------"
echo "Done."
